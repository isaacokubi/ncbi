NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ncbi_cms
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# Private document storage: absolute path on a persistent disk outside the public web root
DOCUMENT_STORAGE_DIR=/var/data/ncbi-private-documents

# Cloudinary is mandatory for all new church photos and videos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Existing legacy local media only (keep configured until migrated)
CHURCH_MEDIA_STORAGE_DIR=/var/data/ncbi-church-media

# One-time initial administrator provisioning (set only when running bootstrap-admin)
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_CODE=
BOOTSTRAP_COUNTRY=Kenya
BOOTSTRAP_CURRENCY=KES

# Safaricom Daraja M-Pesa STK Push (configure with approved credentials)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback/replace-with-callback-secret
MPESA_CALLBACK_SECRET=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
